PORT=3001
HOST=0.0.0.0
# For web clients. Native app connections do not use browser CORS.
ALLOWED_ORIGINS=http://localhost:8081
# Rooms one client address may create per 10 minutes.
ROOM_CREATE_LIMIT=6
# Set to 1 only when exactly one trusted proxy (Render, nginx) sits in front of the server.
TRUST_PROXY=0
